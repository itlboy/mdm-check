<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Chỉ dùng để hỏi GitHub bản mới nhất; việc kiểm tra máy không gửi gì đi. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Cần thấy mọi app để ước tính ngày thiết lập máy (app cài sẵn lúc bật máy lần đầu)
         và tìm agent MDM. App phát hành ngoài CH Play nên không vướng chính sách Play. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Android 11+ ẩn app khác với app thường; khai báo những gì cần nhìn thấy. -->
    <queries>
        <!-- Mọi app đăng ký làm "ứng dụng quản trị thiết bị" -->
        <intent>
            <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
        </intent>
        <!-- Gói hệ thống dùng để ước tính ngày thiết lập máy -->
        <package android:name="com.android.settings" />
        <package android:name="com.android.providers.settings" />
        <!-- Agent MDM / khoá trả góp phổ biến -->
        <package android:name="com.microsoft.windowsintune.companyportal" />
        <package android:name="com.microsoft.intune" />
        <package android:name="com.airwatch.androidagent" />
        <package android:name="com.mobileiron" />
        <package android:name="com.fiberlink.maas360.android.control" />
        <package android:name="com.manageengine.mdm.android" />
        <package android:name="com.hexnode.hexnodemdm" />
        <package android:name="com.promobitech.mobilock.pro" />
        <package android:name="com.sophos.mobilecontrol.client.android" />
        <package android:name="com.payjoy.access" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Cozy MDM Check"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
