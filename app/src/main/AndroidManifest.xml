<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only used to ask GitHub for the latest version; check results never leave the device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needs to see all apps to estimate the setup date (apps preloaded at first boot)
         and to find MDM agents. Distributed outside Google Play, so Play policy does not apply. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Android 11+ hides other apps from regular apps; declare what we need to see. -->
    <queries>
        <!-- Every app registered as a device admin -->
        <intent>
            <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
        </intent>
        <!-- System packages used to estimate the setup date -->
        <package android:name="com.android.settings" />
        <package android:name="com.android.providers.settings" />
        <!-- Common MDM agents / payment-lock apps -->
        <package android:name="com.microsoft.windowsintune.companyportal" />
        <package android:name="com.microsoft.intune" />
        <package android:name="com.airwatch.androidagent" />
        <package android:name="com.mobileiron" />
        <package android:name="com.fiberlink.maas360.android.control" />
        <package android:name="com.manageengine.mdm.android" />
        <package android:name="com.hexnode.hexnodemdm" />
        <package android:name="com.promobitech.mobilock.pro" />
        <package android:name="com.sophos.mobilecontrol.client.android" />
        <package android:name="com.payjoy.access" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Cozy MDM Check"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
